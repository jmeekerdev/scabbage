# Copy to .env next to compose.yaml and change what you need; every line is optional.
# docker compose reads .env by itself. Restart with: docker compose up -d

# --- Version ---
# Released image tag to run, e.g. v0.1.3; latest follows each release. Update: docker compose pull && docker compose up -d
SCABBAGE_VERSION=latest

# --- The game ---
# Name shown in the game's corner and the browser tab.
SCABBAGE_NAME=Scabbage
# Mode for players who haven't been given one: creative or survival.
SCABBAGE_MODE=creative
# Half-width in blocks of the admins-only zone around spawn; 0 turns it off. At most 1024.
SCABBAGE_SPAWN_ZONE=48
# Simulation ticks per second, 1 to 120. Higher costs more CPU; 20 is the tested rate.
SCABBAGE_TICK_RATE=20

# --- Backups ---
# Nightly copies of the world to keep in the data volume's backups/; 0 turns backups off.
SCABBAGE_BACKUPS=7
# Hour of day (0-23) the backup runs, in the time zone below.
SCABBAGE_BACKUP_HOUR=4
# Time zone, e.g. America/Denver.
TZ=UTC

# --- Network ---
# Host port for plain HTTP. Use 127.0.0.1:8080 to reach it only through Caddy on this machine.
SCABBAGE_PORT=8080
# Extra hosts allowed to open the game connection, comma-separated, e.g. play.example.org.
# Only needed when a proxy or tunnel changes the address the browser sees.
SCABBAGE_ORIGINS=

# --- TLS (docker compose --profile tls up -d) ---
# Domain Caddy gets a certificate for; required with the tls profile.
SCABBAGE_DOMAIN=
SCABBAGE_HTTP_PORT=80
SCABBAGE_HTTPS_PORT=443

# --- Storage and limits ---
# Where the world lives: a Docker volume name, or a host folder such as /srv/scabbage.
# A host folder must be writable by the container's user: sudo chown 65532:65532 /srv/scabbage
SCABBAGE_DATA=scabbage-data
# Container memory and CPU limits; keep GOMEMLIMIT about 200 MiB under the memory limit.
SCABBAGE_MEMORY=2g
SCABBAGE_CPUS=2
GOMEMLIMIT=1800MiB
